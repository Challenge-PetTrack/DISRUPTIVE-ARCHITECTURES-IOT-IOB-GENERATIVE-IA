                "29ba5a0fc482cf71",
                "2128d03ed9947509",
                "25c58d992619bd7d"
            ]
        ]
    },
    {
        "id": "55c88989af5d0c8a",
        "type": "function",
        "z": "882ed66569e793ed",
        "name": "Verifica sedentarismo",
        "func": "let atv = msg.payload;\nlet contador = global.get('contador_sed') || 0;\nlet id_pet = global.get('id_pet') || 1;\n\nif (contador >= 3) {\n    global.set('contador_sed', 0);\n    msg.payload = {\n        tipoAlerta: 'SEDENTARISMO',\n        descricao: 'Atividade fisica baixa por 3 leituras: ' + atv.toFixed(0) + ' passos/min',\n        valorRef: atv,\n        resolvido: 'N',\n        pet: { id: id_pet }\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
