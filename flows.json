    {
        "id": "fd37e0c6e2618f50",
        "type": "function",
        "z": "882ed66569e793ed",
        "name": "Trata temperatura",
        "func": "let payload = msg.payload;\nlet temp = Number(payload.valor);\nlet id_pet = payload.id_pet || 1;\n\n// Salva no contexto global\nglobal.set('ultima_temp', temp);\nglobal.set('id_pet', id_pet);\n\n// Passa so o valor para gauge e grafico\nreturn [{ payload: temp }, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 100,
        "wires": [
