    {
        "id": "38c0629e0a5d73b1",
        "type": "function",
        "z": "882ed66569e793ed",
        "name": "Trata atividade",
        "func": "let payload = msg.payload;\nlet atv = Number(payload.valor);\nlet id_pet = payload.id_pet || global.get('id_pet') || 1;\n\n// Salva no contexto global\nglobal.set('ultima_atv', atv);\n\n// Contador de sedentarismo\nlet contador = global.get('contador_sed') || 0;\nif (atv < 20) {\n    contador++;\n    global.set('contador_sed', contador);\n} else {\n    global.set('contador_sed', 0);\n}\n\n// Monta leitura completa so quando tem temperatura tambem\nlet temp = global.get('ultima_temp');\nif (temp !== null && temp !== undefined) {\n    let leitura = {\n        temperatura:  temp,\n        atividade:    atv,\n        topicoMqtt:   msg.topic,\n        pet: { id: id_pet }\n    };\n    return [{ payload: atv }, { payload: leitura }];\n}\nreturn [{ payload: atv }, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 200,
        "wires": [
