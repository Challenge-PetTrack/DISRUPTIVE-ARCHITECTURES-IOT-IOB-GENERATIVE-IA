        "height": 3,
        "format": "<div style=\"font-family:sans-serif;padding:10px\">\n  <div style=\"font-weight:bold;color:#1565C0;margin-bottom:8px\">CLIMA AGORA — SAO PAULO</div>\n  <div style=\"display:flex;flex-wrap:wrap;gap:20px;font-size:15px\">\n    <span>Temp: <b>{{msg.payload.temp}}C</b></span>\n    <span>Umidade: <b>{{msg.payload.umidade}}%</b></span>\n    <span>Chuva: <b>{{msg.payload.chuva}}mm</b></span>\n    <span>Nuvens: <b>{{msg.payload.nuvens}}%</b></span>\n    <span>Vento: <b>{{msg.payload.vento}}km/h</b></span>\n    <span>Cond: <b>{{msg.payload.cond}}</b></span>\n  </div>\n</div>",
        "storeOutMessages": true,
