    },
    {
        "id": "773e75a8e2b0ced7",
        "type": "function",
        "z": "882ed66569e793ed",
        "name": "Trata alerta do ESP32",
        "func": "let payload = msg.payload;\nlet tipo = payload.tipo;\nlet valor = Number(payload.valor);\nlet id_pet = payload.id_pet || global.get('id_pet') || 1;\n\nlet descricao = '';\nif (tipo === 'FEBRE') {\n    descricao = 'Temperatura corporal acima do normal: ' + valor.toFixed(1) + 'C. Consulte um veterinario.';\n} else if (tipo === 'SEDENTARISMO') {\n    descricao = 'Atividade fisica muito baixa: ' + valor.toFixed(0) + ' passos/min por periodo prolongado.';\n}\n\nmsg.payload = {\n    tp_alerta: tipo,\n    ds_descricao: descricao,\n    nr_valor_ref: valor,\n    st_resolvido: 'N',\n    id_pet: id_pet\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 300,
        "wires": [
            [
                "29ba5a0fc482cf71",
                "2128d03ed9947509"
            ]
        ]
    },
    {
        "id": "7a88eec3a7c7a13c",
        "type": "function",
        "z": "882ed66569e793ed",
        "name": "Verifica febre",
        "func": "let temp = msg.payload;\nlet id_pet = global.get('id_pet') || 1;\n\nif (temp > 38.5) {\n    msg.payload = {\n        tipoAlerta: 'FEBRE',\n        descricao: 'Temperatura acima de 39.5C: ' + temp.toFixed(1) + 'C',\n        valorRef: temp,\n        resolvido: 'N',\n        pet: { id: id_pet }\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 60,
        "wires": [
