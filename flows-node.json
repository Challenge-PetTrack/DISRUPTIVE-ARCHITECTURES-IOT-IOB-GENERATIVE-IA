  {
    "id": "n-trata-clima",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Trata clima",
    "func": "let d = msg.payload;\nif (!d || !d.main) {\n    node.warn('OpenWeather erro: ' + JSON.stringify(d));\n    return null;\n}\nlet clima = {\n    temp:    d.main.temp,\n    umidade: d.main.humidity,\n    chuva:   d.rain ? (d.rain['1h'] || 0) : 0,\n    nuvens:  d.clouds.all,\n    vento:   d.wind.speed,\n    cond:    d.weather[0].description\n};\nglobal.set('clima', clima);\nmsg.payload = clima;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 500,
    "wires": [
      [
        "n-ui-clima"
      ]
    ]
  },
