  {
    "id": "n-roteador",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Roteador de topicos",
    "func": "let topic = msg.topic || '';\n\n// Roteia pelo topico\nif (topic.includes('/temperatura')) {\n    return [msg, null, null];\n} else if (topic.includes('/atividade')) {\n    return [null, msg, null];\n} else if (topic.includes('/alerta')) {\n    return [null, null, msg];\n}\nreturn [null, null, null];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 160,
    "wires": [
      [
        "n-trata-temp"
      ],
      [
        "n-trata-atv"
      ],
      [
        "n-trata-alerta-mqtt"
      ]
    ]
  },
  {
    "id": "n-trata-temp",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Trata temperatura",
    "func": "let payload = msg.payload;\nlet temp = Number(payload.valor);\nlet id_pet = payload.id_pet || 1;\n\n// Salva no contexto global\nglobal.set('ultima_temp', temp);\nglobal.set('id_pet', id_pet);\n\n// Passa so o valor para gauge e grafico\nreturn [{ payload: temp }, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 100,
    "wires": [
      [
        "n-gauge-temp",
        "n-chart-temp",
        "n-verifica-febre"
      ],
      []
    ]
  },
  {
    "id": "n-trata-atv",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Trata atividade",
    "func": "let payload = msg.payload;\nlet atv = Number(payload.valor);\nlet id_pet = payload.id_pet || global.get('id_pet') || 1;\n\n// Salva no contexto global\nglobal.set('ultima_atv', atv);\n\n// Contador de sedentarismo\nlet contador = global.get('contador_sed') || 0;\nif (atv < 20) {\n    contador++;\n    global.set('contador_sed', contador);\n} else {\n    global.set('contador_sed', 0);\n}\n\n// Monta leitura completa so quando tem temperatura tambem\nlet temp = global.get('ultima_temp');\nif (temp !== null && temp !== undefined) {\n    let leitura = {\n        id_pet:          id_pet,\n        nr_temperatura:  temp,\n        nr_atividade:    atv,\n        ds_topico_mqtt:  msg.topic\n    };\n    return [{ payload: atv }, { payload: leitura }];\n}\nreturn [{ payload: atv }, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 200,
    "wires": [
      [
        "n-gauge-atv",
        "n-chart-atv",
        "n-verifica-sed"
      ],
      [
        "n-post-leitura"
      ]
    ]
  },
  {
    "id": "n-trata-alerta-mqtt",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Trata alerta do ESP32",
    "func": "let payload = msg.payload;\nlet tipo = payload.tipo;\nlet valor = Number(payload.valor);\nlet id_pet = payload.id_pet || global.get('id_pet') || 1;\n\nlet descricao = '';\nif (tipo === 'FEBRE') {\n    descricao = 'Temperatura corporal acima do normal: ' + valor.toFixed(1) + 'C. Consulte um veterinario.';\n} else if (tipo === 'SEDENTARISMO') {\n    descricao = 'Atividade fisica muito baixa: ' + valor.toFixed(0) + ' passos/min por periodo prolongado.';\n}\n\nmsg.payload = {\n    id_pet: id_pet,\n    tp_alerta: tipo,\n    ds_descricao: descricao,\n    nr_valor_ref: valor,\n    st_resolvido: 'N'\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 300,
    "wires": [
      [
        "n-post-alerta",
        "n-ui-alerta"
      ]
    ]
  },
  {
    "id": "n-verifica-febre",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Verifica febre",
    "func": "let temp = msg.payload;\nlet id_pet = global.get('id_pet') || 1;\n\nif (temp > 39.5) {\n    msg.payload = {\n        id_pet: id_pet,\n        tp_alerta: 'FEBRE',\n        ds_descricao: 'Temperatura corporal elevada detectada pelo Node-RED: ' + temp.toFixed(1) + 'C',\n        nr_valor_ref: temp,\n        st_resolvido: 'N'\n    };\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 940,
    "y": 60,
    "wires": [
      [
        "n-post-alerta",
        "n-ui-alerta"
      ]
    ]
  },
  {
    "id": "n-verifica-sed",
    "type": "function",
    "z": "tab-pettrack",
    "name": "Verifica sedentarismo",
    "func": "let atv = msg.payload;\nlet contador = global.get('contador_sed') || 0;\nlet id_pet = global.get('id_pet') || 1;\n\nif (contador >= 3) {\n    global.set('contador_sed', 0);\n    msg.payload = {\n        id_pet: id_pet,\n        tp_alerta: 'SEDENTARISMO',\n        ds_descricao: 'Atividade fisica baixa por 3 leituras consecutivas: ' + atv.toFixed(0) + ' passos/min',\n        nr_valor_ref: atv,\n        st_resolvido: 'N'\n    };\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 940,
    "y": 160,
    "wires": [
      [
        "n-post-alerta",
        "n-ui-alerta"
      ]
    ]
  },
